{
  "name": "kakoune-core-js",
  "version": "0.3.4",
  "description": "Framework-agnostic Kakoune modal editing engine in JavaScript/TypeScript.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yukaii/codemirror-kakoune.git",
    "directory": "packages/kakoune-core"
  },
  "keywords": [
    "kakoune",
    "modal-editing",
    "editor-engine"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "check:jsr": "npx jsr publish --dry-run --allow-dirty",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  }
}
