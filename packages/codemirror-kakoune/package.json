{
  "name": "codemirror-kakoune",
  "version": "0.3.5",
  "description": "A CodeMirror 6 extension that brings Kakoune-style modal editing to the browser.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yukaii/codemirror-kakoune.git",
    "directory": "packages/codemirror-kakoune"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "check:jsr": "npx jsr publish --dry-run --allow-dirty",
    "probe:parity": "node ../../scripts/kakoune-parity-probe.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "kakoune-core-js": "workspace:*",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^29.1.1",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  }
}
