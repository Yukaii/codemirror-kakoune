{
  "name": "codemirror-kakoune-monorepo",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "build": "pnpm --filter codemirror-kakoune build && pnpm --filter playground build && pnpm --filter obsidian-kakoune build",
    "build:lib": "pnpm --filter codemirror-kakoune build",
    "build:playground": "pnpm --filter playground build",
    "build:obsidian": "pnpm --filter obsidian-kakoune build",
    "test": "pnpm --filter codemirror-kakoune test",
    "test:watch": "pnpm --filter codemirror-kakoune test:watch",
    "check:jsr": "pnpm --filter codemirror-kakoune check:jsr",
    "sync:jsr": "node scripts/sync-jsr-version.mjs",
    "version": "node scripts/sync-jsr-version.mjs && git add packages/codemirror-kakoune/jsr.json",
    "probe:parity": "pnpm --filter codemirror-kakoune probe:parity",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
